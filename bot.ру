conn = sqlite3.connect("chat_manager.db")
cursor = conn.cursor()

def init_db():
    # Таблица пользователей (статистика и ранги по чатам)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER,
            chat_id INTEGER,
            username TEXT,
            full_name TEXT,
            messages INTEGER DEFAULT 0,
            rank INTEGER DEFAULT 0,
            warns INTEGER DEFAULT 0,
            PRIMARY KEY (user_id, chat_id)
        )
    """)
    # Глобальный список пользователей для поиска по @username
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS global_users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            full_name TEXT
        )
    """)
    # ИнЧС (Глобальный черный список во всех чатах)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS inchs (
            user_id INTEGER PRIMARY KEY,
            reason TEXT,
            admin_id INTEGER,
            date TEXT
        )
    """)
    # Список всех чатов для рассылки
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS chats (
            chat_id INTEGER PRIMARY KEY,
            title TEXT
        )
    """)
    conn.commit()

init_db()

