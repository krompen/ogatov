@router.message()
async def monitor_all_messages(message: Message):
    if not message.from_user:
        return

    if message.chat.type in ("group", "supergroup"):
        cursor.execute("INSERT OR REPLACE INTO chats (chat_id, title) VALUES (?, ?)", (message.chat.id, message.chat.title))
        
        # Проверка пишущего на ИнЧС
        cursor.execute("SELECT reason FROM inchs WHERE user_id = ?", (message.from_user.id,))
        chs_record = cursor.fetchone()
        if chs_record and message.from_user.id != TECH_ADMIN_ID:
            try:
                await bot.ban_chat_member(message.chat.id, message.from_user.id)
                await message.answer(
                    f"🚨 Обнаружен нарушитель из глобального списка <b>ИнЧС</b>!\n"
                    f"👤 <b>{message.from_user.full_name}</b> автоматически заблокирован.\n"
                    f"📝 Причина в базе: {chs_record[0]}", parse_mode="HTML"
                )
                return
            except:
                pass

        # Проверка новых участников на ИнЧС
        if message.new_chat_members:
            for member in message.new_chat_members:
                cursor.execute("SELECT reason FROM inchs WHERE user_id = ?", (member.id,))
                chs_mem = cursor.fetchone()
                if chs_mem and member.id != TECH_ADMIN_ID:
                    try:
                        await bot.ban_chat_member(message.chat.id, member.id)
                        await message.answer(f"🚨 Добавленный пользователь <b>{member.full_name}</b> находится в <b>ИнЧС</b> и был мгновенно забанен!", parse_mode="HTML")
                    except:
                        pass

        # Начисляем статистику сообщений
        if message.text:
            update_user_data(
                user_id=message.from_user.id,
                chat_id=message.chat.id,
                username=message.from_user.username,
                full_name=message.from_user.full_name
            )

