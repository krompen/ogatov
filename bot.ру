@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?кик(?:\s+(.*))?$"))
async def cmd_kick(message: Message):
    if message.chat.type == "private": return
    admin_rank = get_rank(message.from_user.id, message.chat.id)
    if admin_rank < 2:
        return await message.reply("❌ Кик доступен со 2 ранга (Модератор).")

    match = re.match(r"^(?:!|/|\.)?кик(?:\s+(.*))?$", message.text, re.IGNORECASE)
    target_id, target_name, _ = await resolve_target(message, match.group(1) or "")
    if not target_id:
        return await message.reply("⚠️ Укажите пользователя для кика.")
    if target_id == TECH_ADMIN_ID or (get_rank(target_id, message.chat.id) >= admin_rank and message.from_user.id != TECH_ADMIN_ID):
        return await message.reply("❌ Недостаточно прав для исключения этого пользователя.")

    try:
        await bot.ban_chat_member(message.chat.id, target_id)
        await bot.unban_chat_member(message.chat.id, target_id)
        await message.reply(f"👢 Пользователь <b>{target_name}</b> исключен из беседы!", parse_mode="HTML")
    except TelegramBadRequest as e:
        await message.reply(f"❌ Ошибка: {e.message}")


