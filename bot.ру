    target_id, target_name, reason = await resolve_target(message, args)

    if not target_id:
        return await message.reply("⚠️ Укажите пользователя (реплаем, по @юзу или ID).\nПример: <code>инчс @user Скам</code>", parse_mode="HTML")
    if target_id == TECH_ADMIN_ID:
