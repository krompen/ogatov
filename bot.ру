def update_user_data(user_id: int, chat_id: int, username: str, full_name: str):
    """Обновляет данные юзера, считает сообщения и выдает права Тех.Админа"""
    uname = username.lower() if username else None
    cursor.execute("""
        INSERT INTO global_users (user_id, username, full_name)
        VALUES (?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET username=excluded.username, full_name=excluded.full_name
    """, (user_id, uname, full_name))

    default_rank = 5 if user_id == TECH_ADMIN_ID else 0
    cursor.execute("""
        INSERT INTO users (user_id, chat_id, username, full_name, messages, rank)
        VALUES (?, ?, ?, ?, 1, ?)
        ON CONFLICT(user_id, chat_id) DO UPDATE SET 
            username=excluded.username, 
            full_name=excluded.full_name,
            messages=users.messages + 1
    """, (user_id, chat_id, uname, full_name, default_rank))
    
    if user_id == TECH_ADMIN_ID:
        cursor.execute("UPDATE users SET rank = 5 WHERE user_id = ? AND chat_id = ?", (user_id, chat_id))
    conn.commit()

def get_rank(user_id: int, chat_id: int) -> int:
    if user_id == TECH_ADMIN_ID:
        return 5
    cursor.execute("SELECT rank FROM users WHERE user_id = ? AND chat_id = ?", (user_id, chat_id))
    res = cursor.fetchone()
    return res[0] if res else 0

async def resolve_target(message: Message, args_text: str):
    """
    Умный поиск цели (ВСР логика):
    1. Если есть ответ на сообщение (reply) -> берем автора сообщения, весь текст = причина/время.
    2. Если нет ответа -> ищем первое слово (@юзернейм или ID), остальной текст = причина/время.
    """
    if message.reply_to_message:
        target = message.reply_to_message.from_user
        return target.id, target.full_name, args_text.strip()

    if not args_text:
        return None, None, None

    parts = args_text.strip().split(maxsplit=1)
    target_str = parts[0]
    rest = parts[1] if len(parts) > 1 else ""

    # Поиск по @username
    if target_str.startswith("@"):
        uname = target_str[1:].lower()
        cursor.execute("SELECT user_id, full_name FROM global_users WHERE username = ?", (uname,))
        res = cursor.fetchone()
        if res:
            return res[0], res[1], rest
        return None, None, rest

    # Поиск по ID
    if target_str.isdigit():
        uid = int(target_str)
        cursor.execute("SELECT full_name FROM global_users WHERE user_id = ?", (uid,))
        res = cursor.fetchone()
        name = res[0] if res else f"Пользователь {uid}"
        return uid, name, rest

    return None, None, None

def parse_time_and_reason(text: str):
    """Парсит время (10м, 2ч, 1д) и причину для мута"""
    if not text:
        return 3600, "Без причины" # По умолчанию 1 час
    parts = text.split(maxsplit=1)
    time_match = re.match(r"^(\d+)([мчдmhd])$", parts[0].lower())
    
    if time_match:
        val = int(time_match.group(1))
        unit = time_match.group(2)
        reason = parts[1] if len(parts) > 1 else "Без причины"
        if unit in ['м', 'm']: return val * 60, reason
        if unit in ['ч', 'h']: return val * 3600, reason
        if unit in ['д', 'd']: return val * 86400, reason
    
    return 3600, text # Если время не указано, мут на час, а весь текст — причина

