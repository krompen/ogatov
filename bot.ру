@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?рассылка(?:\s+(.*))?$"))
async def cmd_broadcast(message: Message):
    rank = get_rank(message.from_user.id, message.chat.id)
    if message.from_user.id != TECH_ADMIN_ID and rank < 4:
        return await message.reply("❌ Рассылка доступна только Тех. Администратору или Владельцам.")

    match = re.match(r"^(?:!|/|\.)?рассылка(?:\s+(.*))?$", message.text, re.IGNORECASE | re.DOTALL)
    text_to_send = match.group(1)

    if not text_to_send and not message.reply_to_message:
        return await message.reply("⚠️ Напишите текст после слова «рассылка» или ответьте командой <code>рассылка</code> на любое сообщение (с фото/видео).", parse_mode="HTML")

    cursor.execute("SELECT chat_id FROM chats")
    chats = cursor.fetchall()

    sent = 0
    await message.reply("⏳ Начинаю рассылку по чатам...")

    for (cid,) in chats:
        try:
            if message.reply_to_message:
                await message.reply_to_message.copy_to(cid)
            else:
                await bot.send_message(
                    cid, 
                    f"📢 <b>Официальное объявление:</b>\n\n{text_to_send}\n\n<i>Отправил: {message.from_user.full_name}</i>", 
                    parse_mode="HTML"
                )
            sent += 1
            await asyncio.sleep(0.05)
        except:
            pass

    await message.reply(f"✅ Рассылка успешно доставлена в <b>{sent}</b> чатов!", parse_mode="HTML")


