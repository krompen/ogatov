# --- МУТ И РАЗМУТ (Ранг >= 1) ---
@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?мут(?:\s+(.*))?$"))
async def cmd_mute(message: Message):
    if message.chat.type == "private": return
    admin_rank = get_rank(message.from_user.id, message.chat.id)
    if admin_rank < 1:
        return await message.reply("❌ Мут доступен с 1 ранга (Младший модератор).")

    match = re.match(r"^(?:!|/|\.)?мут(?:\s+(.*))?$", message.text, re.IGNORECASE)
    args = match.group(1) or ""
    target_id, target_name, rest = await resolve_target(message, args)

    if not target_id:
        return await message.reply("⚠️ Укажите цель!\nПримеры:\n• Ответом: <code>мут 30м Флуд</code>\n• По юзу: <code>мут @user 2ч Оскорбление</code>", parse_mode="HTML")

    if target_id == TECH_ADMIN_ID:
        return await message.reply("🛡 На Тех. Администратора мут не действует!")
    if get_rank(target_id, message.chat.id) >= admin_rank and message.from_user.id != TECH_ADMIN_ID:
        return await message.reply("❌ Нельзя замутить старшего или равного по рангу!")

    seconds, reason = parse_time_and_reason(rest)
    until_date = datetime.now() + timedelta(seconds=seconds)

    try:
        permissions = ChatPermissions(can_send_messages=False)
        await bot.restrict_chat_member(message.chat.id, target_id, permissions=permissions, until_date=until_date)
        mins = seconds // 60
        await message.reply(
            f"🔇 <b>Выдан мут!</b>\n"
            f"👤 Кому: <b>{target_name}</b> (<code>{target_id}</code>)\n"
            f"⏳ Срок: {mins} мин.\n"
            f"📝 Причина: {reason}", parse_mode="HTML"
        )
    except TelegramBadRequest as e:
        await message.reply(f"❌ Ошибка выдачи мута: {e.message}")


