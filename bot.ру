# --- ПОВЫШЕНИЕ И ПОНИЖЕНИЕ (Ранги) ---
@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?(повысить|понизить)(?:\s+(.*))?$"))
async def cmd_promote_demote(message: Message):
    if message.chat.type == "private": return
    admin_rank = get_rank(message.from_user.id, message.chat.id)
    if admin_rank < 4:
        return await message.reply("❌ Управлять должностями могут только Владельцы (4 ранг) и Тех. Админ (5 ранг).")

    match = re.match(r"^(?:!|/|\.)?(повысить|понизить)(?:\s+(.*))?$", message.text, re.IGNORECASE)
    action = match.group(1).lower()
    args = match.group(2) or ""

    target_id, target_name, _ = await resolve_target(message, args)
    if not target_id:
        return await message.reply(f"⚠️ Кого нужно {action}? Ответьте на сообщение или укажите @юзернейм / ID.")

    if target_id == TECH_ADMIN_ID:
        return await message.reply("⚙️ Ранг Тех. Администратора неизменен!")

    cursor.execute("INSERT OR IGNORE INTO users (user_id, chat_id, full_name, rank) VALUES (?, ?, ?, 0)",
                   (target_id, message.chat.id, target_name))
    current_rank = get_rank(target_id, message.chat.id)

    if current_rank >= admin_rank and message.from_user.id != TECH_ADMIN_ID:
        return await message.reply("❌ Вы не можете менять ранг пользователю с равной или более высокой должностью.")

    if action == "повысить":
        max_allowed = 4 if message.from_user.id == TECH_ADMIN_ID else admin_rank - 1
        if current_rank >= max_allowed:
            return await message.reply(f"⚠️ Достигнут максимальный доступный для выдачи ранг ({RANKS[current_rank]}).")
        new_rank = current_rank + 1
        emoji = "⬆️"
    else:
        if current_rank <= 0:
            return await message.reply("⚠️ Пользователь уже обычный участник (0 ранг).")
        new_rank = current_rank - 1
        emoji = "⬇️"

    cursor.execute("UPDATE users SET rank = ? WHERE user_id = ? AND chat_id = ?", (new_rank, target_id, message.chat.id))
    conn.commit()

    await message.reply(
        f"{emoji} <b>Изменение должности!</b>\n"
        f"👤 Пользователь: <b>{target_name}</b>\n"
        f"🔰 Новая должность: <b>{RANKS[new_rank]}</b> [{new_rank} ур.]", parse_mode="HTML"
    )


