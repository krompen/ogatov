def generate_stats_card(full_name: str, user_id: int, rank_lvl: int, messages: int, warns: int, in_chs: bool) -> BytesIO:
    width, height = 800, 420
    img = Image.new("RGB", (width, height), color=(24, 24, 36))
    draw = ImageDraw.Draw(img)

    # Декоративные рамки и акценты
    draw.rectangle([20, 20, width - 20, height - 20], outline=(65, 65, 95), width=3)
    draw.rectangle([20, 20, 35, height - 20], fill=(0, 210, 180) if not in_chs else (230, 50, 70))

    # Загрузка шрифтов (Windows / Linux / Default)
    try:
        font_title = ImageFont.truetype("arial.ttf", 38)
        font_text = ImageFont.truetype("arial.ttf", 26)
    except:
        try:
            font_title = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 36)
            font_text = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 25)
        except:
            font_title = ImageFont.load_default()
            font_text = ImageFont.load_default()

    # Заголовок
    draw.text((65, 45), f"ПРОФИЛЬ: {full_name[:22]}", fill=(255, 255, 255), font=font_title)
    draw.line([(65, 98), (740, 98)], fill=(65, 65, 95), width=2)

    # Данные профиля
    rank_str = RANKS.get(rank_lvl, "Участник")
    chs_str = "ДА (В ГЛОБАЛЬНОМ ЧС!)" if in_chs else "Чист"
    chs_color = (255, 70, 70) if in_chs else (100, 240, 140)

    draw.text((65, 120), f"🆔 ID пользователя: {user_id}", fill=(200, 200, 220), font=font_text)
    draw.text((65, 165), f"🔰 Должность: {rank_str} [{rank_lvl} ур.]", fill=(0, 210, 180), font=font_text)
    draw.text((65, 210), f"💬 Сообщений в чате: {messages}", fill=(200, 200, 220), font=font_text)
    draw.text((65, 255), f"⚠️ Предупреждения: {warns} / 3", fill=(255, 190, 80), font=font_text)
    draw.text((65, 300), f"🚫 Статус ИнЧС: {chs_str}", fill=chs_color, font=font_text)

    # Полоса активности (прогресс-бар до 1000 сообщений)
    bar_x, bar_y, bar_w, bar_h = 65, 355, 675, 22
    draw.rectangle([bar_x, bar_y, bar_x + bar_w, bar_y + bar_h], fill=(40, 40, 60))
    progress = min(1.0, messages / 1000.0)
    if progress > 0:
        draw.rectangle([bar_x, bar_y, bar_x + int(bar_w * progress), bar_y + bar_h], fill=(0, 210, 180))
    
    bio = BytesIO()
    img.save(bio, format="PNG")
    bio.seek(0)
    return bio

