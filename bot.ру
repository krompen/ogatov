@router.message(F.text.lower() == "выдать админку")
async def claim_owner(message: Message):
    if message.chat.type == "private":
        return
    member = await bot.get_chat_member(message.chat.id, message.from_user.id)
    if member.status == "creator" or message.from_user.id == TECH_ADMIN_ID:
        rank_to_set = 5 if message.from_user.id == TECH_ADMIN_ID else 4
        cursor.execute("UPDATE users SET rank = ? WHERE user_id = ? AND chat_id = ?", 
                       (rank_to_set, message.from_user.id, message.chat.id))
        conn.commit()
        await message.reply(f"✅ Права синхронизированы! Ваш ранг: <b>{RANKS[rank_to_set]}</b>", parse_mode="HTML")
    else:
        await message.reply("❌ Эта команда доступна только создателю беседы или Тех. Администратору.")


# --- БАН И РАЗБАН (Ранг >= 3) ---
@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?бан(?:\s+(.*))?$"))
async def cmd_ban(message: Message):
    if message.chat.type == "private": return
    admin_rank = get_rank(message.from_user.id, message.chat.id)
    if admin_rank < 3:
        return await message.reply("❌ Команда «бан» доступна с 3 ранга (Старший админ).")

    match = re.match(r"^(?:!|/|\.)?бан(?:\s+(.*))?$", message.text, re.IGNORECASE)
    args = match.group(1) or ""
    target_id, target_name, reason = await resolve_target(message, args)

    if not target_id:
        return await message.reply("⚠️ Укажите пользователя (ответом на сообщение, через @юзернейм или ID).\nПример: <code>бан @user Спам</code>", parse_mode="HTML")
    
    if target_id == TECH_ADMIN_ID:
        return await message.reply("🛡 Невозможно забанить главного Тех. Администратора!")
    if get_rank(target_id, message.chat.id) >= admin_rank and message.from_user.id != TECH_ADMIN_ID:
        return await message.reply("❌ Вы не можете забанить равного или старшего по званию!")

    reason = reason if reason else "Не указана"
    try:
        await bot.ban_chat_member(message.chat.id, target_id)
        await message.reply(
            f"🔨 <b>Пользователь заблокирован!</b>\n"
            f"👤 Кого: <b>{target_name}</b> (<code>{target_id}</code>)\n"
            f"👮‍♂️ Кем: <b>{message.from_user.full_name}</b>\n"
            f"📝 Причина: {reason}", parse_mode="HTML"
        )
    except TelegramBadRequest as e:
        await message.reply(f"❌ Ошибка Телеграм (проверьте права бота): {e.message}")


