@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?варн(?:\s+(.*))?$"))
async def cmd_warn(message: Message):
    if message.chat.type == "private": return
    admin_rank = get_rank(message.from_user.id, message.chat.id)
    if admin_rank < 2:
        return await message.reply("❌ Выдача варнов доступна со 2 ранга (Модератор).")

    match = re.match(r"^(?:!|/|\.)?варн(?:\s+(.*))?$", message.text, re.IGNORECASE)
    args = match.group(1) or ""
    target_id, target_name, reason = await resolve_target(message, args)

    if not target_id:
        return await message.reply("⚠️ Укажите пользователя (реплай, @юзер или ID).")
    if target_id == TECH_ADMIN_ID or (get_rank(target_id, message.chat.id) >= admin_rank and message.from_user.id != TECH_ADMIN_ID):
        return await message.reply("❌ Нельзя выдать варн старшему или равному по рангу!")

    reason = reason if reason else "Нарушение правил"
    cursor.execute("INSERT OR IGNORE INTO users (user_id, chat_id, full_name) VALUES (?, ?, ?)", (target_id, message.chat.id, target_name))
    cursor.execute("UPDATE users SET warns = warns + 1 WHERE user_id = ? AND chat_id = ?", (target_id, message.chat.id))
    cursor.execute("SELECT warns FROM users WHERE user_id = ? AND chat_id = ?", (target_id, message.chat.id))
    warns = cursor.fetchone()[0]
    conn.commit()

    if warns >= 3:
        cursor.execute("UPDATE users SET warns = 0 WHERE user_id = ? AND chat_id = ?", (target_id, message.chat.id))
        conn.commit()
        try:
            await bot.ban_chat_member(message.chat.id, target_id)
            await message.reply(f"🔨 <b>{target_name}</b> получил 3/3 предупреждений и был <b>заблокирован</b>!\nПричина последнего варна: {reason}", parse_mode="HTML")
        except TelegramBadRequest as e:
            await message.reply(f"⚠️ Достигнуто 3/3 варнов, но не удалось забанить: {e.message}")
    else:
        await message.reply(f"⚠️ <b>{target_name}</b> получил предупреждение ({warns}/3)!\n📝 Причина: {reason}", parse_mode="HTML")


@router.message(F.text.lower().regexp(r"^(?:!|/|\.)?(?:снять варн|разварн)(?:\s+(.*))?$"))
